# Reference only: export these variables in your shell. Files are not auto-loaded.
STREAM_HOST=127.0.0.1
STREAM_PORT=8000
STREAM_STALE_AFTER_SECONDS=90
STREAM_RECOVERY_SAMPLES=2
STREAM_RECOVERY_MARGIN_M=0.05
STREAM_TREND_MIN_SPAN_SECONDS=10
# Relative paths are resolved against 02_backend, regardless of launch directory.
STREAM_DB_PATH=data/telemetry.db
STREAM_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
